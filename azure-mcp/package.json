{
  "name": "azure-mcp-wrapper",
  "version": "1.0.0",
  "private": true,
  "description": "Reproducible local launcher and safety helpers for the official Azure MCP server.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "powershell -NoProfile -File scripts/start-server.ps1",
    "verify": "powershell -NoProfile -File scripts/validate-installation.ps1",
    "verify:tools": "powershell -NoProfile -File scripts/validate-installation.ps1 -CheckTools",
    "test": "powershell -NoProfile -File tests/run-tests.ps1",
    "lint:powershell": "powershell -NoProfile -File tests/run-script-analyzer.ps1"
  },
  "dependencies": {
    "@azure/mcp": "3.0.0-beta.31"
  }
}
