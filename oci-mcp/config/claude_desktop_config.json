{
  "_comment": "Claude Desktop config — copy the mcpServers object into %APPDATA%\\Claude\\claude_desktop_config.json. On Windows, npx-based entries must use cmd /c.",
  "mcpServers": {
    "oci-extras": {
      "command": "node",
      "args": ["C:/Workspace/MCP Servers/oci-mcp/oci-extras-mcp/index.js"],
      "env": {
        "OCI_CONFIG_PROFILE": "DEFAULT",
        "OCI_REGION": "sa-saopaulo-1",
        "OCI_MCP_DEFAULT_DRY_RUN": "true",
        "OCI_MCP_ALLOW_DESTRUCTIVE": "false",
        "OCI_MCP_ALLOW_THIRD_PARTY_MUTATION": "false",
        "OCI_MCP_ALLOW_SECRET_REVEAL": "false"
      }
    },
    "oci-api": {
      "command": "cmd",
      "args": ["/c", "uvx", "oracle.oci-api-mcp-server@latest"],
      "env": { "OCI_CONFIG_PROFILE": "DEFAULT", "FASTMCP_LOG_LEVEL": "ERROR" }
    },
    "oci-compute": {
      "command": "cmd",
      "args": ["/c", "uvx", "oracle.oci-compute-mcp-server@latest"],
      "env": { "OCI_CONFIG_PROFILE": "DEFAULT", "FASTMCP_LOG_LEVEL": "ERROR" }
    },
    "oci-identity": {
      "command": "cmd",
      "args": ["/c", "uvx", "oracle.oci-identity-mcp-server@latest"],
      "env": { "OCI_CONFIG_PROFILE": "DEFAULT", "FASTMCP_LOG_LEVEL": "ERROR" }
    },
    "oci-networking": {
      "command": "cmd",
      "args": ["/c", "uvx", "oracle.oci-networking-mcp-server@latest"],
      "env": { "OCI_CONFIG_PROFILE": "DEFAULT", "FASTMCP_LOG_LEVEL": "ERROR" }
    },
    "oci-load-balancer": {
      "command": "cmd",
      "args": ["/c", "uvx", "oracle.oci-load-balancer-mcp-server@latest"],
      "env": { "OCI_CONFIG_PROFILE": "DEFAULT", "FASTMCP_LOG_LEVEL": "ERROR" }
    },
    "oci-monitoring": {
      "command": "cmd",
      "args": ["/c", "uvx", "oracle.oci-monitoring-mcp-server@latest"],
      "env": { "OCI_CONFIG_PROFILE": "DEFAULT", "FASTMCP_LOG_LEVEL": "ERROR" }
    },
    "oci-logging": {
      "command": "cmd",
      "args": ["/c", "uvx", "oracle.oci-logging-mcp-server@latest"],
      "env": { "OCI_CONFIG_PROFILE": "DEFAULT", "FASTMCP_LOG_LEVEL": "ERROR" }
    },
    "oci-registry": {
      "command": "cmd",
      "args": ["/c", "uvx", "oracle.oci-registry-mcp-server@latest"],
      "env": { "OCI_CONFIG_PROFILE": "DEFAULT", "FASTMCP_LOG_LEVEL": "ERROR" }
    },
    "oci-cloud-guard": {
      "command": "cmd",
      "args": ["/c", "uvx", "oracle.oci-cloud-guard-mcp-server@latest"],
      "env": { "OCI_CONFIG_PROFILE": "DEFAULT", "FASTMCP_LOG_LEVEL": "ERROR" }
    }
  }
}
