{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "oci-extras-mcp": {
      "type": "local",
      "command": ["node", "C:/Workspace/MCP Servers/oci-mcp/oci-extras-mcp/index.js"],
      "env": {
        "OCI_CONFIG_PROFILE": "DEFAULT",
        "OCI_REGION": "sa-saopaulo-1",
        "OCI_MCP_DEFAULT_DRY_RUN": "true"
      },
      "enabled": true
    },
    "oci-api": {
      "type": "local",
      "command": ["cmd", "/c", "uvx", "oracle.oci-api-mcp-server@latest"],
      "env": { "OCI_CONFIG_PROFILE": "DEFAULT", "FASTMCP_LOG_LEVEL": "ERROR" },
      "enabled": true
    },
    "oci-compute": {
      "type": "local",
      "command": ["cmd", "/c", "uvx", "oracle.oci-compute-mcp-server@latest"],
      "env": { "OCI_CONFIG_PROFILE": "DEFAULT", "FASTMCP_LOG_LEVEL": "ERROR" },
      "enabled": true
    },
    "oci-identity": {
      "type": "local",
      "command": ["cmd", "/c", "uvx", "oracle.oci-identity-mcp-server@latest"],
      "env": { "OCI_CONFIG_PROFILE": "DEFAULT", "FASTMCP_LOG_LEVEL": "ERROR" },
      "enabled": true
    },
    "oci-networking": {
      "type": "local",
      "command": ["cmd", "/c", "uvx", "oracle.oci-networking-mcp-server@latest"],
      "env": { "OCI_CONFIG_PROFILE": "DEFAULT", "FASTMCP_LOG_LEVEL": "ERROR" },
      "enabled": true
    },
    "oci-monitoring": {
      "type": "local",
      "command": ["cmd", "/c", "uvx", "oracle.oci-monitoring-mcp-server@latest"],
      "env": { "OCI_CONFIG_PROFILE": "DEFAULT", "FASTMCP_LOG_LEVEL": "ERROR" },
      "enabled": true
    }
  }
}
