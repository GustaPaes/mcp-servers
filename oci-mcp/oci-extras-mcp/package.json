{
  "name": "oci-extras-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for Oracle Cloud Infrastructure — OKE, Vault/Secrets, Functions and streaming logs. Complements oracle/mcp upstream.",
  "license": "UPL-1.0",
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:http": "node index.js --http",
    "test": "node tests/auth-resolver.test.mjs && node tests/smoke-http.mjs",
    "test:http": "node tests/smoke-http.mjs",
    "test:auth": "node tests/auth-resolver.test.mjs",
    "lint": "node --check index.js && node --check src/server.js && node --check src/http.js"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.7",
    "js-yaml": "^5.2.2",
    "oci-common": "^2.138.0",
    "oci-containerengine": "^2.138.0",
    "oci-core": "^2.138.0",
    "oci-functions": "^2.138.0",
    "oci-identity": "^2.138.0",
    "oci-keymanagement": "^2.138.0",
    "oci-loggingsearch": "^2.138.0",
    "oci-secrets": "^2.138.0",
    "oci-vault": "^2.138.0",
    "oci-workrequests": "^2.138.0",
    "pino": "^9.6.0",
    "zod": "^3.25.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oci",
    "oracle-cloud",
    "oke",
    "kubernetes",
    "vault",
    "secrets",
    "functions"
  ]
}
