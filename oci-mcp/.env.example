# =============================================================================
# OCI MCP — Environment Template
# Copy to .env and fill in. NEVER commit the real .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication (choose ONE primary method)
# -----------------------------------------------------------------------------
# Options: api_key | session_token | instance_principal | resource_principal
OCI_AUTH_METHOD=api_key

# Path to OCI config (default: ~/.oci/config). Used by api_key & session_token.
# OCI_CONFIG_FILE=C:/Users/<you>/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# Default region (overrides config profile)
OCI_REGION=sa-saopaulo-1

# Default tenancy / compartment for tools that accept implicit scope
OCI_TENANCY_OCID=
OCI_DEFAULT_COMPARTMENT_OCID=

# -----------------------------------------------------------------------------
# Safety / Guardrails
# -----------------------------------------------------------------------------
# Set to "true" to allow destructive operations (delete, terminate, schedule_deletion).
# Even when true, mutations on resources NOT created by this MCP still require
# explicit "confirm" input parameter matching the resource name/OCID.
OCI_MCP_ALLOW_DESTRUCTIVE=false

# Set to "true" to allow reveal of secret values (default returns masked).
OCI_MCP_ALLOW_SECRET_REVEAL=false

# Default to dry-run for all write tools when "dryRun" is not specified by caller.
OCI_MCP_DEFAULT_DRY_RUN=true

# Strict mode: refuses ANY edit/delete on pre-existing (non-MCP-created) resources
# unless input contains explicit { confirm: "<name-or-ocid>" } AND
# OCI_MCP_ALLOW_THIRD_PARTY_MUTATION=true.
OCI_MCP_ALLOW_THIRD_PARTY_MUTATION=false

# Path to ownership ledger (tracks resources created by this MCP).
OCI_MCP_OWNERSHIP_LEDGER=./.ownership-ledger.json

# -----------------------------------------------------------------------------
# Audit & Logs
# -----------------------------------------------------------------------------
LOG_LEVEL=info
AUDIT_LOG_FILE=./logs/audit.jsonl
LOG_REDACT_SECRETS=true

# -----------------------------------------------------------------------------
# Transport
# -----------------------------------------------------------------------------
# HTTP Streamable mode (only when started with --http)
MCP_HTTP_PORT=3020
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_BASE_URL=http://127.0.0.1:3020
# Required by the server when MCP_HTTP_HOST is not loopback.
MCP_HTTP_TOKEN=
MCP_HTTP_BODY_LIMIT_BYTES=1048576
MCP_HTTP_SESSION_TTL_MS=1800000

# -----------------------------------------------------------------------------
# Kubernetes layer
# -----------------------------------------------------------------------------
# Path to write/merge OKE kubeconfig (defaults to ~/.kube/config)
# KUBECONFIG=C:/Users/<you>/.kube/config

# -----------------------------------------------------------------------------
# OCI IAM (only for HTTP transport with IDCS auth — optional)
# -----------------------------------------------------------------------------
# IDCS_DOMAIN=
# IDCS_CLIENT_ID=
# IDCS_CLIENT_SECRET=
# IDCS_AUDIENCE=
# IDCS_REQUIRED_SCOPES=
