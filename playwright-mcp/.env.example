# Playwright MCP — configuration
# Copy this file to .env and tweak as needed. All variables are optional.

# --- General -----------------------------------------------------------------
LOG_LEVEL=info                          # trace|debug|info|warn|error|silent
PWMCP_LOG_FILE=                         # if set, also write structured logs here (in addition to stderr)

# --- Browser defaults --------------------------------------------------------
PWMCP_DEFAULT_HEADLESS=false            # default for browser_launch when not specified
PWMCP_DEFAULT_BROWSER=chromium          # chromium|firefox|webkit
PWMCP_DEFAULT_CHANNEL=                  # chrome|chrome-beta|msedge|msedge-beta|"" (empty = bundled chromium)
PWMCP_DEFAULT_VIEWPORT=1366x768         # WxH
PWMCP_DEFAULT_LOCALE=pt-BR
PWMCP_DEFAULT_TIMEZONE=America/Sao_Paulo

# --- Session management ------------------------------------------------------
PWMCP_MAX_SESSIONS=5                    # cap on concurrent browser sessions
PWMCP_SESSION_TTL_MINUTES=30            # idle TTL before auto-close (0 = disabled)
PWMCP_SESSION_SWEEP_INTERVAL_SECONDS=60 # how often the cleanup loop runs

# --- Output ------------------------------------------------------------------
# Absolute path preferred. Defaults to <repo>/output. Subfolders created on demand.
PWMCP_OUTPUT_DIR=
PWMCP_MAX_ARTIFACT_BYTES=2000000        # omit large inline base64; artifact remains on disk
PWMCP_MAX_NETWORK_BODY_BYTES=65536      # cap network bodies returned to the client

# --- Safety ------------------------------------------------------------------
PWMCP_STRICT=true                       # block privileged URLs and sensitive browser storage access
PWMCP_ALLOW_SECRET_REVEAL=false         # allow explicit cookie value reveal
PWMCP_ALLOW_BROWSER_INSTALL=false       # browser_install changes the host; opt in explicitly
PWMCP_ALLOWED_FILE_ROOTS=               # path-delimited upload roots; defaults to this repository
PWMCP_ALLOWED_PROFILE_ROOTS=            # defaults to ./local-private/profiles
PWMCP_EVAL_TIMEOUT_MS=5000              # timeout per page_evaluate call
PWMCP_ACTION_TIMEOUT_MS=10000           # default Playwright action timeout
PWMCP_NAVIGATION_TIMEOUT_MS=30000       # default Playwright navigation timeout

# --- HTTP transport (optional) ----------------------------------------------
# PWMCP_HTTP_PORT=3030
# PWMCP_HTTP_HOST=127.0.0.1
