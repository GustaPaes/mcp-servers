{
  "name": "playwright-mcp",
  "version": "0.1.0",
  "description": "MCP server for Playwright browser automation (chromium/firefox/webkit + chrome/edge channels), multi-session, with HAR/video/tracing/PDF/intercept/stealth.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "bin": {
    "playwright-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --test --test-reporter=spec --import=tsx tests/smoke.test.ts tests/safety.test.ts tests/security.test.ts",
    "test:install-browsers": "playwright install chromium",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@gustapaes/mcp-runtime": "file:../packages/mcp-runtime",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "playwright": "^1.62.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
