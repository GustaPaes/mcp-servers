# =====================================================================
# career-development-mcp — Environment Template
# Copy to .env and tweak as needed.
# =====================================================================

# --- General ---------------------------------------------------------
LOG_LEVEL=info

# --- HTTP transport (only when started with `npm run start:http`) ----
MCP_HTTP_PORT=3020
MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_TOKEN=                       # required when binding outside loopback
# MCP_HTTP_BODY_LIMIT_BYTES=1048576
# MCP_HTTP_SESSION_TTL_MS=1800000
# MCP_HTTP_MAX_SESSIONS=50

# --- Cross-MCP integration -------------------------------------------
# Path to the local tfs-mcp folder, used by guide_evidence_from_tfs
# to spawn its sibling server and import work-item context as evidence.
# TFS_MCP_SERVER_DIR=../tfs-mcp
# CAREER_MCP_TFS_TIMEOUT_MS=30000

# --- Storage ---------------------------------------------------------
# Local JSON storage path for PDIs, goals, evidences, etc.
# CAREER_MCP_DATA_DIR=./data

# Allowed roots for sanitized snapshot imports. Separate multiple paths with
# ";" on Windows or ":" on Linux/macOS.
# CAREER_MCP_IMPORT_ROOTS=./local-private
# CAREER_MCP_IMPORT_MAX_BYTES=1048576

# Number of previous versions retained per local JSON record.
# CAREER_MCP_BACKUP_RETENTION=20

# --- Optional live career provider ----------------------------------
# Local tools remain local. guide_remote_* explicitly reads/writes the provider.
# CAREER_REMOTE_PROVIDER=none           # none | idp
# CAREER_REMOTE_API_URL=https://api.example.com
# Exact public DNS hostnames; no wildcards, private IPs or redirects.
# CAREER_REMOTE_ALLOWED_HOSTS=api.example.com
# Optional fixed IDP API routes. Only documented keys and matching placeholders:
# CAREER_REMOTE_ROUTES_JSON={"self":"/me","plan":"/idp/plans/{planId}"}
# Choose ONE private authentication source, never commit real values:
# CAREER_REMOTE_AUTH_TOKEN=
# CAREER_REMOTE_AUTH_COOKIE=
# Cookie-only JSON: {"cookies":[...]} from an authorized session. No localStorage.
# CAREER_REMOTE_SESSION_ROOT=./local-private/auth
# CAREER_REMOTE_SESSION_FILE=./local-private/auth/provider-session.json
# CAREER_REMOTE_TIMEOUT_MS=15000        # 100..60000, total per request; no retries
# CAREER_REMOTE_MAX_RESPONSE_BYTES=1048576  # 1024..5242880
# CAREER_REMOTE_PREVIEW_TTL_MS=600000    # 1000..1800000
# CAREER_REMOTE_MAX_RECORDS=500         # 10..2000 preview/audit records; fail closed
