# =====================================================================
# career-development-mcp — Environment Template
# Copy to .env and tweak as needed.
# =====================================================================

# --- General ---------------------------------------------------------
LOG_LEVEL=info

# --- HTTP transport (only when started with `npm run start:http`) ----
MCP_HTTP_PORT=3020
MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_TOKEN=                       # required when binding outside loopback
# MCP_HTTP_BODY_LIMIT_BYTES=1048576
# MCP_HTTP_SESSION_TTL_MS=1800000
# MCP_HTTP_MAX_SESSIONS=50

# --- Cross-MCP integration -------------------------------------------
# Path to the local tfs-mcp folder, used by guide_evidence_from_tfs
# to spawn its sibling server and import work-item context as evidence.
# TFS_MCP_SERVER_DIR=C:/Workspace/MCP Servers/tfs-mcp

# --- Storage ---------------------------------------------------------
# Local JSON storage path for PDIs, goals, evidences, etc.
# CAREER_MCP_DATA_DIR=./data
