    "smoke:http": "node smoke-http.mjs",
    "test:unit": "node ../packages/mcp-runtime/bin/run-node-tests.js tests",
    "test": "node ../packages/mcp-runtime/bin/run-node-tests.js tests && node validate-tools.mjs"
  },
  "dependencies": {
    "@gustapaes/mcp-runtime": "file:../packages/mcp-runtime",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "zod": "^4.5.4"
