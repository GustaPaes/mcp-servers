{
  "name": "career-development-mcp",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for PDIs, SMART goals, competencies, evidence and career review workflows.",
  "license": "MIT",
  "main": "index.js",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "career",
    "goals",
    "pdi",
    "evidence"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node index.js",
    "start:http": "node index.js --http",
