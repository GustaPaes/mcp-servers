{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "tfs-mcp": {
      "type": "local",
      "command": [
        "node",
        "C:/Workspace/MCP Servers/tfs-mcp/index.js"
      ],
      "enabled": false,
      "env": {
        "TFS_MCP_CONFIG_FILE": "C:/Workspace/MCP Servers/tfs-mcp/local-private/config/tfs.json"
      }
    },
    "career-development-mcp": {
      "type": "local",
      "command": [
        "node",
        "C:/Workspace/MCP Servers/career-development-mcp/index.js"
      ],
      "enabled": true,
      "env": {
        "LOG_LEVEL": "info",
        "TFS_MCP_SERVER_DIR": "C:/Workspace/MCP Servers/tfs-mcp"
      }
    },
    "playwright-mcp": {
      "type": "local",
      "command": [
        "node",
        "C:/Workspace/MCP Servers/playwright-mcp/dist/index.js"
      ],
      "enabled": true,
      "env": {
        "PWMCP_DEFAULT_HEADLESS": "false",
        "PWMCP_DEFAULT_BROWSER": "chromium",
        "PWMCP_DEFAULT_CHANNEL": "chrome",
        "PWMCP_STRICT": "true",
        "PWMCP_ALLOWED_PROFILE_ROOTS": "C:/Workspace/MCP Servers/playwright-mcp/local-private/profiles"
      }
    },
    "azure-mcp": {
      "type": "local",
      "command": [
        "powershell",
        "-NoProfile",
        "-File",
        "C:/Workspace/MCP Servers/azure-mcp/scripts/start-server.ps1"
      ],
      "enabled": true
    },
    "oci-extras-mcp": {
      "type": "local",
      "command": [
        "node",
        "C:/Workspace/MCP Servers/oci-mcp/oci-extras-mcp/index.js"
      ],
      "enabled": false,
      "env": {
        "OCI_AUTH_METHOD": "session_token",
        "OCI_REGION": "sa-saopaulo-1",
        "OCI_MCP_DEFAULT_DRY_RUN": "true",
        "OCI_MCP_ALLOW_DESTRUCTIVE": "false",
        "OCI_MCP_ALLOW_SECRET_REVEAL": "false",
        "OCI_MCP_ALLOW_THIRD_PARTY_MUTATION": "false"
      }
    },
    "meta-ads-mcp": {
      "type": "local",
      "command": [
        "node",
        "C:/Workspace/MCP Servers/meta-ads-mcp/dist/server.js"
      ],
      "enabled": false,
      "env": {
        "ACCOUNTS_CONFIG_PATH": "C:/Workspace/MCP Servers/meta-ads-mcp/config/accounts.json",
        "AUDIT_LOG_PATH": "C:/Workspace/MCP Servers/meta-ads-mcp/data/audit.log",
        "STORAGE_PATH": "C:/Workspace/MCP Servers/meta-ads-mcp/data/storage.json",
        "META_GRAPH_API_VERSION": "v25.0",
        "READ_ONLY": "true",
        "DRY_RUN": "true",
        "GLOBAL_MAX_DAILY_BUDGET": "500",
        "GLOBAL_MAX_BUDGET_CHANGE_PCT": "25"
      }
    }
  }
}
