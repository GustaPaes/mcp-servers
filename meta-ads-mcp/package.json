{
  "name": "meta-ads-mcp",
  "version": "0.1.0",
  "description": "Professional, multi-account MCP Server for Meta Marketing API (Facebook Ads / Instagram Ads) with safe optimization, audit and compliance.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "meta-ads-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "meta-ads",
    "facebook-ads",
    "instagram-ads",
    "marketing-api",
    "performance-marketing",
    "ai-tools"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@gustapaes/mcp-runtime": "file:../packages/mcp-runtime",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "undici": "^8.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  }
}
