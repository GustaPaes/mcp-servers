# ----------------------------------------------------------------------------
# Meta Ads MCP Server - Environment variables
# Copy this file to ".env" and adjust. NEVER commit a real .env to git.
# ----------------------------------------------------------------------------

# Node environment: development | production | test
NODE_ENV=development

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Path to accounts.json (multi-account configuration). Tokens are NEVER stored
# in this file directly: each account references an env var name that holds
# the actual access token (see accounts.example.json).
ACCOUNTS_CONFIG_PATH=./config/accounts.json

# Path where the audit log will be written (JSONL file).
AUDIT_LOG_PATH=./data/audit.log

# Where to persist drafts, recommendations and storage state.
STORAGE_PATH=./data/storage.json

# Meta Marketing API version
META_GRAPH_API_VERSION=v25.0

# Base URL for Graph API (override only for testing/mocking).
META_GRAPH_API_BASE_URL=https://graph.facebook.com

# Global safety switches (also enforceable per account).
# READ_ONLY=true  -> disables every tool that mutates anything on Meta.
# DRY_RUN=true    -> mutating tools simulate but never call the real API.
READ_ONLY=true
DRY_RUN=true

# Default per-execution caps (in account currency, integer minor units... here major units).
# Used as a hard ceiling on top of per-account limits.
GLOBAL_MAX_DAILY_BUDGET=500
GLOBAL_MAX_BUDGET_CHANGE_PCT=25

# HTTP client tuning (chamadas SAINDO para a Graph API)
HTTP_TIMEOUT_MS=30000
HTTP_MAX_RETRIES=4
HTTP_RETRY_BASE_DELAY_MS=500

# ----------------------------------------------------------------------------
# Transporte MCP
#   stdio  -> padrão; usado por Claude Desktop, Cursor, opencode local.
#   http   -> Streamable HTTP (multi-cliente, painel web, deploy remoto).
# ----------------------------------------------------------------------------
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8787
# Tokens Bearer aceitos no header Authorization, separados por vírgula.
# Vazio = SEM autenticação (só seguro em 127.0.0.1).
MCP_HTTP_BEARER_TOKENS=
# true (padrão) = sessões com Mcp-Session-Id; false = stateless one-shot.
MCP_HTTP_STATEFUL=true
MCP_HTTP_BODY_LIMIT_BYTES=1048576
MCP_HTTP_SESSION_TTL_MS=1800000
MCP_HTTP_MAX_SESSIONS=50

# ----------------------------------------------------------------------------
# Storage backend
#   file    -> JSON em disco (padrão, zero-config)
#   memory  -> não-persistente, para testes/dev
#   prisma  -> Postgres via @prisma/client (requer instalação opcional)
# ----------------------------------------------------------------------------
STORAGE_BACKEND=file
# DATABASE_URL=postgresql://user:pass@localhost:5432/meta_ads_mcp

# Example tokens (REFERENCED BY accounts.json, not loaded directly here)
# These are placeholders — set the real values only locally / in a secret manager.
META_TOKEN_ACME_FASHION=
META_TOKEN_ACME_SAAS=
