# Web panel auth. Use a strong random value in real environments.
WEB_PANEL_PASSWORD=change-me
WEB_PANEL_SESSION_SECRET=replace-with-at-least-32-random-chars

# MCP HTTP endpoint. Start the MCP server with MCP_TRANSPORT=http.
META_ADS_MCP_HTTP_URL=http://127.0.0.1:8787/mcp
META_ADS_MCP_BEARER_TOKEN=

# Optional display defaults.
NEXT_PUBLIC_PANEL_TITLE=Meta Ads Control Room
