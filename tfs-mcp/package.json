{
  "name": "tfs-mcp",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for TFS / Azure DevOps Server work items, PRs, reviews and delivery workflows.",
  "license": "MIT",
  "main": "index.js",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tfs",
    "azure-devops",
    "work-items",
    "pull-requests"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node index.js",
    "start:http": "node index.js --http",
    "validate:contract": "node --test tests/server-contract.test.mjs",
    "validate:premium": "node validate-premium.mjs",
    "validate:live": "node validate-premium.mjs",
    "validate:workflows:live": "node validate-premium.mjs",
    "test:unit": "node ../packages/mcp-runtime/bin/run-node-tests.js tests",
    "test:smoke": "node -e \"import('./src/server.js').then(() => console.log('server module ok'))\"",
    "test:http": "node smoke-http.mjs",
    "smoke:http": "node smoke-http.mjs",
    "test": "node ../packages/mcp-runtime/bin/run-node-tests.js tests"
  },
  "dependencies": {
    "@gustapaes/mcp-config-kit": "file:../packages/config-kit",
    "@gustapaes/mcp-runtime": "file:../packages/mcp-runtime",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^18.0.1",
    "pino": "^9.6.0",
    "zod": "^4.6.5"
  }
}
