# =====================================================================
# tfs-mcp — Environment Template
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# =====================================================================

# --- TFS / Azure DevOps Server endpoint ------------------------------
TFS_URL=https://tfs.example.com
# Optional legacy defaults for calls without collection/project arguments.
TFS_COLLECTION=ExampleCollection
TFS_PROJECT=ExampleProject

# --- Repositories the MCP can search across (comma-separated) --------
# Used by PR tools when "repo" is not explicitly informed in the call.
TFS_REPOS=repo-one,repo-two,repo-three

# --- Personal Access Tokens ------------------------------------------
# Two ways to provide PATs:
#
#   (a) A single default PAT:
# TFS_PAT=your-pat-here
#
#   (b) Multiple PATs by alias — recommended when several humans/bots share the MCP.
# TFS_PAT_READER=replace-with-local-pat
# TFS_PAT_WRITER=replace-with-local-pat
# TFS_DEFAULT_AUTH_ALIAS=reader
#
# In tool calls pass `auth_alias: "reader"` to choose a PAT. A scope can also set authAlias.

# --- Optional --------------------------------------------------------
# TFS_REPO=legacy-default-repo            # legacy single-repo fallback
# TFS_WORKSPACE_ROOT=<workspace-root> # helps repo auto-detection
# TFS_REQUEST_TIMEOUT_MS=30000
# TFS_MAX_RETRIES=3                    # retries only safe/idempotent requests
# TFS_RETRY_MAX_DELAY_MS=8000          # Retry-After is honored up to this cap
# TFS_MCP_MAX_INPUT_ITEMS=500
# TFS_MCP_MAX_INPUT_STRING_CHARS=250000
# TFS_MCP_MAX_RESPONSE_BYTES=2000000
# MCP_HTTP_PORT=3010                      # only used with `npm run start:http`
# MCP_HTTP_HOST=127.0.0.1                 # non-loopback requires MCP_HTTP_TOKEN
# MCP_HTTP_TOKEN=                         # bearer token for HTTP mode
# MCP_HTTP_BODY_LIMIT_BYTES=1048576
# MCP_HTTP_SESSION_TTL_MS=1800000
# MCP_HTTP_MAX_SESSIONS=50
# TFS_AUDIT_LOG_PATH=./data/audit.log
# TFS_DEFAULT_QUARTER=                    # defaults to the current calendar quarter
# TFS_WORK_ITEM_PROFILES_JSON={}          # JSON keyed by work item type; supports businessField, technicalField and defaults
# Example: {"Change Request":{"businessField":"Custom.BusinessContext","technicalField":"Custom.TechnicalDetails","defaults":{"Custom.Portfolio":"Platform","Custom.Quarter":"{{currentQuarter}}"}}}
# TFS_ISSUE_ANALYSIS_FIELD=                # reference name for an Issue's required analysis field
# TFS_ISSUE_CORRECTION_AND_IMPACTS_FIELD=  # optional reference name for correction/impact text
# TFS_TASK_GROUP_AUTH_ALIAS=               # optional PAT alias for local task-group maintenance scripts
# LOG_LEVEL=info
