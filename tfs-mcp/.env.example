# =====================================================================
# tfs-mcp MCP — Environment Template
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# =====================================================================

# --- TFS / Azure DevOps Server endpoint ------------------------------
TFS_URL=https://tfs.example.com
TFS_COLLECTION=YourCollection
TFS_PROJECT=YourProject

# --- Repositories the MCP can search across (comma-separated) --------
# Used by PR tools when "repo" is not explicitly informed in the call.
TFS_REPOS=repo-one,repo-two,repo-three

# --- Personal Access Tokens ------------------------------------------
# Two ways to provide PATs:
#
#   (a) A single default PAT:
# TFS_PAT=your-pat-here
#
#   (b) Multiple PATs by alias — recommended when several humans/bots share the MCP.
# TFS_PAT_ALICE=alice-pat
# TFS_PAT_BOB=bob-pat
# TFS_DEFAULT_AUTH_ALIAS=alice
#
# In tool calls you can pass `auth_alias: "alice"` to choose which PAT to use.

# --- Optional --------------------------------------------------------
# TFS_REPO=legacy-default-repo            # legacy single-repo fallback
# TFS_WORKSPACE_ROOT=C:/Workspace/yourapp # helps repo auto-detection
# MCP_HTTP_PORT=3010                      # only used with `npm run start:http`
# LOG_LEVEL=info
